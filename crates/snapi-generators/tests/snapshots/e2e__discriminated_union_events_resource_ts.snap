import type { OrderPlacedEvent, PaymentProcessedEvent, UserCreatedEvent } from "../models";

export class EventsResource {
  constructor(private baseUrl: string, private headers: Record<string, string> = {}) {}

  /** List all events */
  async listEvents(query?: { since?: string; limit?: number }): Promise<(UserCreatedEvent | OrderPlacedEvent | PaymentProcessedEvent)[]> {
    let url = new URL(`${this.baseUrl}/events`).toString();
    if (query) {
      const params = new URLSearchParams();
      if (query.since != null) params.set("since", String(query.since));
      if (query.limit != null) params.set("limit", String(query.limit));
      url = url + '?' + params.toString();
    }
    const response = await fetch(url, {
      method: "GET",
      headers: { ...this.headers },
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json() as Promise<(UserCreatedEvent | OrderPlacedEvent | PaymentProcessedEvent)[]>;
  }

  /** Get a single event */
  async getEvent(id: string): Promise<UserCreatedEvent | OrderPlacedEvent | PaymentProcessedEvent> {
    const url = new URL(`${this.baseUrl}/events/${id}`).toString();
    const response = await fetch(url, {
      method: "GET",
      headers: { ...this.headers },
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json() as Promise<UserCreatedEvent | OrderPlacedEvent | PaymentProcessedEvent>;
  }

}
