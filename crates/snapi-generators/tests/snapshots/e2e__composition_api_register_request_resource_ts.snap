import type { AacRtpMode, ApiError, InputRtpVideoOptions, InputWhepVideoOptions, InputWhipVideoOptions, OutputHlsAudioOptions, OutputHlsVideoOptions, OutputMp4AudioOptions, OutputMp4VideoOptions, OutputRtmpClientAudioOptions, OutputRtmpClientVideoOptions, OutputRtpAudioOptions, OutputRtpVideoOptions, OutputWhepAudioOptions, OutputWhepVideoOptions, OutputWhipAudioOptions, OutputWhipVideoOptions, Resolution, TransportProtocol } from "../models";

export class RegisterRequestResource {
  constructor(private baseUrl: string, private headers: Record<string, string> = {}) {}

  async registerFont(compositionId: string, body: { font: string }): Promise<{ bearer_token: string } | { audio_duration_ms?: number | null; video_duration_ms?: number | null } | { port?: number | null } | Record<string, unknown>> {
    const url = new URL(`${this.baseUrl}/api/composition/${compositionId}/font/register`).toString();
    const response = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...this.headers },
      body: JSON.stringify(body),
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json() as Promise<{ bearer_token: string } | { audio_duration_ms?: number | null; video_duration_ms?: number | null } | { port?: number | null } | Record<string, unknown>>;
  }

