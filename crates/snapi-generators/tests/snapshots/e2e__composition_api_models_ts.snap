It's an error to provide `height` if `width` is not defined. */
  height?: number | null;
  id?: null | string;
  /** Distance between lines in pixels. Defaults to the value of the `font_size` property. */
  line_height?: number | null;
  /** (**default=`4320`**) Maximal `height`. Limits the height of the texture that the text will be rendered on.
Value is ignored if height is defined. */
  max_height?: number | null;
  /** (**default=`7682`**) Maximal `width`. Limits the width of the texture that the text will be rendered on.
Value is ignored if `width` is defined. */
  max_width?: number | null;
  style?: null | TextStyle;
  /** Text that will be rendered. */
  text: string;
  weight?: null | TextWeight;
  /** Width of a texture that text will be rendered on. If not provided, the resulting texture
will be sized based on the defined text but limited to `max_width` value. */
  width?: number | null;
  wrap?: null | TextWrapMode;
}

export type TextStyle =
  | "normal"
  | "italic"
  | "oblique";

export type TextWeight =
  | "thin"
  | "extra_light"
  | "light"
  | "normal"
  | "medium"
  | "semi_bold"
  | "bold"
  | "extra_bold"
  | "black";

export type TextWrapMode =
  | "none"
  | "glyph"
  | "word";

export interface Tiles {
  background_color?: null | string;
  /** List of component's children. */
  children?: ({ id?: null | string; input_id: string; type: "input_stream" } | { background_color?: null | string; border_color?: null | string; border_radius?: number | null; border_width?: number | null; bottom?: number | null; box_shadow?: BoxShadow[] | null; children?: Component[] | null; direction?: null | ViewDirection; height?: number | null; id?: null | string; left?: number | null; overflow?: null | Overflow; padding?: number | null; padding_bottom?: number | null; padding_horizontal?: number | null; padding_left?: number | null; padding_right?: number | null; padding_top?: number | null; padding_vertical?: number | null; right?: number | null; rotation?: number | null; top?: number | null; transition?: null | Transition; width?: number | null; type: "view" } | { align?: null | HorizontalAlign; background_color?: null | string; color?: null | string; font_family?: string | null; font_size: number; height?: number | null; id?: null | string; line_height?: number | null; max_height?: number | null; max_width?: number | null; style?: null | TextStyle; text: string; weight?: null | TextWeight; width?: number | null; wrap?: null | TextWrapMode; type: "text" } | { type: "tiles" } | { border_color?: null | string; border_radius?: number | null; border_width?: number | null; bottom?: number | null; box_shadow?: BoxShadow[] | null; child: Component; height?: number | null; horizontal_align?: null | HorizontalAlign; id?: null | string; left?: number | null; mode?: null | RescaleMode; right?: number | null; rotation?: number | null; top?: number | null; transition?: null | Transition; vertical_align?: null | VerticalAlign; width?: number | null; type: "rescaler" })[] | null;
  /** Height of a component in pixels. Exact behavior might be different based on the parent
component:
- If the parent component is a layout, check sections "Absolute positioning" and "Static
  positioning" of that component.
- If the parent component is not a layout, then this field is required. */
  height?: number | null;
  horizontal_align?: null | HorizontalAlign;
  id?: null | string;
  /** (**default=`0`**) Margin of each tile in pixels. */
  margin?: number | null;
  /** (**default=`0`**) Padding on each tile in pixels. */
  padding?: number | null;
  tile_aspect_ratio?: null | string;
  transition?: null | Transition;
  vertical_align?: null | VerticalAlign;
  /** Width of a component in pixels. Exact behavior might be different based on the parent
component:
- If the parent component is a layout, check sections "Absolute positioning" and "Static
  positioning" of that component.
- If the parent component is not a layout, then this field is required. */
  width?: number | null;
}

export interface Transition {
  /** Duration of a transition in milliseconds. */
  duration_ms: number;
  easing_function?: null | { function_name: "linear" } | { function_name: "bounce" } | { function_name: "cubic_bezier"; points: number[] };
  /** (**default=`false`**) On scene update, if there is already a transition in progress,
it will be interrupted and the new transition will start from the current state. */
  should_interrupt?: boolean | null;
}

export type TransportProtocol =
  | "udp"
  | "tcp_server";

export interface UnregisterInput {
  /** Time in milliseconds when this request should be applied. Value `0` represents
time of the start request. */
  schedule_time_ms?: number | null;
}

export interface UnregisterOutput {
  /** Time in milliseconds when this request should be applied. Value `0` represents
time of the start request. */
  schedule_time_ms?: number | null;
}

export interface UnregisterRenderer {
  /** Time in milliseconds when this request should be applied. Value `0` represents
time of the start request. */
  schedule_time_ms?: number | null;
}

export interface UpdateOutputRequest {
  audio?: null | AudioScene;
  schedule_time_ms?: number | null;
  video?: null | VideoScene;
}

export type VerticalAlign =
  | "top"
  | "center"
  | "bottom"
  | "justified";

export type VideoEncoderBitrate = number | { average_bitrate: number; max_bitrate: number };

export interface VideoScene {
  root: { id?: null | string; input_id: string; type: "input_stream" } | { background_color?: null | string; border_color?: null | string; border_radius?: number | null; border_width?: number | null; bottom?: number | null; box_shadow?: BoxShadow[] | null; children?: Component[] | null; direction?: null | ViewDirection; height?: number | null; id?: null | string; left?: number | null; overflow?: null | Overflow; padding?: number | null; padding_bottom?: number | null; padding_horizontal?: number | null; padding_left?: number | null; padding_right?: number | null; padding_top?: number | null; padding_vertical?: number | null; right?: number | null; rotation?: number | null; top?: number | null; transition?: null | Transition; width?: number | null; type: "view" } | { align?: null | HorizontalAlign; background_color?: null | string; color?: null | string; font_family?: string | null; font_size: number; height?: number | null; id?: null | string; line_height?: number | null; max_height?: number | null; max_width?: number | null; style?: null | TextStyle; text: string; weight?: null | TextWeight; width?: number | null; wrap?: null | TextWrapMode; type: "text" } | { background_color?: null | string; children?: Component[] | null; height?: number | null; horizontal_align?: null | HorizontalAlign; id?: null | string; margin?: number | null; padding?: number | null; tile_aspect_ratio?: null | string; transition?: null | Transition; vertical_align?: null | VerticalAlign; width?: number | null; type: "tiles" } | { border_color?: null | string; border_radius?: number | null; border_width?: number | null; bottom?: number | null; box_shadow?: BoxShadow[] | null; child: Component; height?: number | null; horizontal_align?: null | HorizontalAlign; id?: null | string; left?: number | null; mode?: null | RescaleMode; right?: number | null; rotation?: number | null; top?: number | null; transition?: null | Transition; vertical_align?: null | VerticalAlign; width?: number | null; type: "rescaler" };
}

export interface View {
  background_color?: null | string;
  border_color?: null | string;
  /** (**default=`0.0`**) Radius of a rounded corner. */
  border_radius?: number | null;
  /** (**default=`0.0`**) Border width. */
  border_width?: number | null;
  /** Distance in pixels between the bottom edge of this component and the bottom edge of its
parent (including a border). If this field is defined, this element will be absolutely
positioned, instead of being laid out by its parent. */
  bottom?: number | null;
  /** List of box shadows. */
  box_shadow?: BoxShadow[] | null;
  /** List of component's children. */
  children?: ({ id?: null | string; input_id: string; type: "input_stream" } | { type: "view" } | { align?: null | HorizontalAlign; background_color?: null | string; color?: null | string; font_family?: string | null; font_size: number; height?: number | null; id?: null | string; line_height?: number | null; max_height?: number | null; max_width?: number | null; style?: null | TextStyle; text: string; weight?: null | TextWeight; width?: number | null; wrap?: null | TextWrapMode; type: "text" } | { background_color?: null | string; children?: Component[] | null; height?: number | null; horizontal_align?: null | HorizontalAlign; id?: null | string; margin?: number | null; padding?: number | null; tile_aspect_ratio?: null | string; transition?: null | Transition; vertical_align?: null | VerticalAlign; width?: number | null; type: "tiles" } | { border_color?: null | string; border_radius?: number | null; border_width?: number | null; bottom?: number | null; box_shadow?: BoxShadow[] | null; child: Component; height?: number | null; horizontal_align?: null | HorizontalAlign; id?: null | string; left?: number | null; mode?: null | RescaleMode; right?: number | null; rotation?: number | null; top?: number | null; transition?: null | Transition; vertical_align?: null | VerticalAlign; width?: number | null; type: "rescaler" })[] | null;
  direction?: null | ViewDirection;
  /** Height of a component in pixels (without a border). Exact behavior might be different
based on the parent component:
- If the parent component is a layout, check sections "Absolute positioning" and "Static
  positioning" of that component.
- If the parent component is not a layout, then this field is required. */
  height?: number | null;
  id?: null | string;
  /** Distance in pixels between this component's left edge and its parent's left edge (including a border).
If this field is defined, this element will be absolutely positioned, instead of being
laid out by its parent. */
  left?: number | null;
  overflow?: null | Overflow;
  /** (**default=`0.0`**) Padding for all sides of the component. */
  padding?: number | null;
  /** (**default=`0.0`**) Padding on bottom side in pixels. */
  padding_bottom?: number | null;
  /** (**default=`0.0`**) Padding for the left and right of the component. */
  padding_horizontal?: number | null;
  /** (**default=`0.0`**) Padding on left side in pixels. */
  padding_left?: number | null;
  /** (**default=`0.0`**) Padding on right side in pixels. */
  padding_right?: number | null;
  /** (**default=`0.0`**) Padding on top side in pixels. */
  padding_top?: number | null;
  /** (**default=`0.0`**) Padding for the top and bottom of the component. */
  padding_vertical?: number | null;
  /** Distance in pixels between this component's right edge and its parent's right edge.
If this field is defined, this element will be absolutely positioned, instead of being
laid out by its parent. */
  right?: number | null;
  /** Rotation of a component in degrees. If this field is defined, this element will be
absolutely positioned, instead of being laid out by its parent. */
  rotation?: number | null;
  /** Distance in pixels between this component's top edge and its parent's top edge (including a border).
If this field is defined, then the component will ignore a layout defined by its parent. */
  top?: number | null;
  transition?: null | Transition;
  /** Width of a component in pixels (without a border). Exact behavior might be different
based on the parent component:
- If the parent component is a layout, check sections "Absolute positioning" and "Static
  positioning" of that component.
- If the parent component is not a layout, then this field is required. */
  width?: number | null;
}

export type ViewDirection =
  | "row"
  | "column";

export type WhepAudioEncoderOptions = { expected_packet_loss?: number | null; forward_error_correction?: boolean | null; preset?: null | OpusEncoderPreset; sample_rate?: number | null; type: "opus" };

export interface WhepInput {
  /** Optional Bearer token for auth */
  bearer_token?: string | null;
  /** WHEP server endpoint URL */
  endpoint_url: string;
  /** Offset in milliseconds relative to the pipeline start (start request). */
  offset_ms?: number | null;
  /** (**default=`false`**) If input is required and the stream is not delivered
on time, then Smelter will delay producing output frames. */
  required?: boolean | null;
  video?: null | InputWhepVideoOptions;
}

export interface WhepOutput {
  audio?: null | OutputWhepAudioOptions;
  /** Token used for authentication in WHEP protocol.
If not provided, the bearer token is not required to establish the session. */
  bearer_token?: string | null;
  video?: null | OutputWhepVideoOptions;
}

export type WhepVideoDecoderOptions =
  | "ffmpeg_h264"
  | "ffmpeg_vp8"
  | "ffmpeg_vp9"
  | "vulkan_h264"
  | "any";

export type WhepVideoEncoderOptions = { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; pixel_format?: null | PixelFormat; preset?: null | H264EncoderPreset; type: "ffmpeg_h264" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; type: "ffmpeg_vp8" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; pixel_format?: null | PixelFormat; type: "ffmpeg_vp9" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; keyframe_interval_ms?: number | null; type: "vulkan_h264" };

export type WhipAudioEncoderOptions = { forward_error_correction?: boolean | null; preset?: null | OpusEncoderPreset; sample_rate?: number | null; type: "opus" } | { type: "any" };

export interface WhipInput {
  /** Token used for authentication in WHIP protocol. If not provided, the random value
will be generated and returned in the response. */
  bearer_token?: string | null;
  /** Internal use only.
Overrides whip endpoint id which is used when referencing the input via whip server.
If not provided, it defaults to input id. */
  endpoint_override?: string | null;
  /** Offset in milliseconds relative to the pipeline start (start request). If the offset is
not defined then the stream will be synchronized based on the delivery time of the initial
frames. */
  offset_ms?: number | null;
  /** (**default=`false`**) If input is required and the stream is not delivered
on time, then Smelter will delay producing output frames. */
  required?: boolean | null;
  video?: null | InputWhipVideoOptions;
}

export interface WhipOutput {
  audio?: null | OutputWhipAudioOptions;
  bearer_token?: string | null;
  /** WHIP server endpoint */
  endpoint_url: string;
  video?: null | OutputWhipVideoOptions;
}

export type WhipVideoDecoderOptions =
  | "ffmpeg_h264"
  | "ffmpeg_vp8"
  | "ffmpeg_vp9"
  | "vulkan_h264"
  | "any";

export type WhipVideoEncoderOptions = { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; pixel_format?: null | PixelFormat; preset?: null | H264EncoderPreset; type: "ffmpeg_h264" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; type: "ffmpeg_vp8" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; ffmpeg_options?: Record<string, string> | null; keyframe_interval_ms?: number | null; pixel_format?: null | PixelFormat; type: "ffmpeg_vp9" } | { bitrate?: null | number | { average_bitrate: number; max_bitrate: number }; keyframe_interval_ms?: number | null; type: "vulkan_h264" } | { type: "any" };
