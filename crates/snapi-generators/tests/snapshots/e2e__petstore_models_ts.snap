export interface NewPet {
  name: string;
  tag?: string;
}

export interface Pet {
  /** Unique pet identifier */
  id: number;
  /** Pet name */
  name: string;
  status?: PetStatus;
  /** Optional categorisation tag */
  tag?: string;
}

export type PetStatus =
  | "available"
  | "pending"
  | "sold";
